# ====== LLM Model (GEMINI - Evaluation & Production) ======
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROVIDER=google
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# ====== LLM Model (OLLAMA - Development) ======
OLLAMA_MODEL_NAME=your_ollama_model_name_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048
OLLAMA_TIMEOUT_SECONDS=60   # local model runs by GPU/RAM => timeout longer than API

# ====== Embedding Model ======
EMBEDDING_MODEL_NAME=your_embedding_model_name_here
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# ====== Database (POSTGRESQL) ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_postgres_database_here
POSTGRES_USER=your_username_here
POSTGRES_PASSWORD=your_password_here
POSTGRES_POOL_SIZE=5

# ====== BM25 ======
BM25_K1=1.5
BM25_B=0.75

# ====== RETRIEVER ======
RETRIEVER_TOP_K=10
RETRIEVER_RERANK_TOP_N=5
RETRIEVER_BM25_WEIGHT=0.3
RETRIEVER_VECTOR_WEIGHT=0.7

# ====== THRESHOLDS ======
RETRIEVAL_GRADE_THRESHOLD=0.6
GROUNDING_GRADE_THRESHOLD=0.7
LONG_TERM_MEMORY_THRESHOLD=0.8

# ====== SELF-CORRECTION ======
MAX_RETRIEVAL_RETRIES=3
MAX_GENERATION_RETRIES=3
MAX_TOTAL_RETRIES=5

# ====== Observability ======
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
TRACE_ENABLED=true
METRICS_ENABLED=true
